{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokopia-stamp-edge",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "assets": {
    "directory": "../../autocontroller_rebuild_for_RL/pokopia_web/static",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/media/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "LIVE", "class_name": "LiveState"},
      {"name": "RATE_LIMITER", "class_name": "ClientRateLimiter"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["LiveState", "ClientRateLimiter"]}
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokopia-stamp",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {"binding": "MEDIA", "bucket_name": "pokopia-stamp-media"}
  ],
  "routes": [
    {"pattern": "stamp.rabi.date", "custom_domain": true},
    {"pattern": "rabi.date", "custom_domain": true}
  ],
  "vars": {
    "CANONICAL_HOST": "stamp.rabi.date",
    "OFFLINE_AFTER_SECONDS": "30"
  }
}
